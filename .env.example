# =============================================================
# BARBEARIA SAAS — Variáveis de Ambiente (raiz do monorepo)
# Copie para .env na raiz se precisar destes valores em scripts/Compose.
# A API e o Prisma usam principalmente backend/.env (ver backend/.env.example).
# =============================================================

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=seu-secret-jwt-muito-lungo-e-aleatorio
JWT_REFRESH_SECRET=outro-secret-jwt-refresh-muito-lungo

# ── Stripe ────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Email (Resend) ────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@suabarbearia.com.br

# ── MinIO / S3 ────────────────────────────────────────────────
# (Preenchido automaticamente pelo docker-compose.yml)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
